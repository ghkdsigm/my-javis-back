# 코드 주석에 이모티콘은 사용하지 않습니다.
# Server
PORT=4000
HOST=0.0.0.0

# LLM mode: openai | llamacpp | mock
LLM_MODE=llamacpp

# OpenAI-compatible endpoint (Ollama / LM Studio / vLLM / llama.cpp --server --api with OpenAI compat etc.)
# For Ollama with OpenAI compat, base tends to be http://127.0.0.1:11434/v1
# For LM Studio, something like http://127.0.0.1:1234/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=exaone3.5:7.8b

# llama.cpp legacy HTTP server (old /completion API). Prefer openai mode if you can.
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_N_THREADS=4

OPENWEATHER_API_KEY=0e5d6fa35e94db225750772dba7dad2a
OPENWEATHER_DEFAULT_CITY=Seoul,KR

NAVER_CLIENT_ID=oEtRgoXR6wLOJD0vynU0
NAVER_CLIENT_SECRET=IkK6ANAT1Z
NAVER_NEWS_DISPLAY=10
NAVER_NEWS_SORT=sim


EMBEDDING_PROVIDER=llamacpp   # openai | llamacpp
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3      # 또는 text-embedding-3-large 등
EMBEDDING_API_KEY=
INTENT_THRESHOLD=0.35

# SMTP (메일 전송을 서버에서 할 경우)
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_USER=you@yourhost.com
SMTP_PASS=yourpass
SMTP_FROM=you@yourhost.com

MINIMAX_TTS_BASE=https://api.minimax.io/v1/t2a_v2
MINIMAX_GROUP_ID=1985277876982780246
MINIMAX_API_KEY=test
